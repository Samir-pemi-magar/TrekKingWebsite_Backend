generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────────────────
// - USER: regular customer. passwordHash is nullable because guest inquiries
//   and guest bookings don't require an account.
// - ORGANIZER: owns/manages Trips (organizerId) and publishes Posts.
// - GUIDE: field staff who can be assigned to a TripDeparture. Does not own
//   trips, but can be linked to one or more departures.
// - ADMIN: full control — all trips, all users, all posts/bookings, can
//   promote/demote roles.
model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String?
  googleId        String?   @unique
  emailVerifiedAt DateTime? // null = not verified yet
  name            String?
  phone           String?
  bio             String?
  nationality     String?
  avatarUrl       String?
  avatarPublicId  String?
  role            Role      @default(USER)
  isActive        Boolean   @default(true) // soft-disable instead of hard delete
  deletedAt       DateTime? // soft delete marker (final — set by admin delete or once a self-requested deletion's grace period elapses)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // ── Self-service delayed account deletion ──────────────────────────────
  // A user can request their own account be deleted; rather than deleting
  // immediately, we give them a 7-day grace period to change their mind.
  // deletionRequestedAt is just a record of when they asked. scheduledDeletionAt
  // is deletionRequestedAt + 7 days — a background job (finalizeDueAccountDeletions
  // in user.model.ts) sweeps for rows where this has passed and finalizes
  // them into the normal deletedAt soft-delete. Cancelling (undo) just nulls
  // both fields out; the account never leaves isActive/deletedAt=null state
  // during the grace period, so nothing else in the app needs to change.
  deletionRequestedAt DateTime?
  scheduledDeletionAt DateTime?

  trips            Trip[]          @relation("OrganizerTrips")
  posts             Post[]          @relation("AuthoredPosts")
  bookings          Booking[]       @relation("UserBookings")
  reviews           Review[]
  wishlist          Wishlist[]
  guidedDepartures  TripDeparture[] @relation("AssignedGuide")
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]      @relation("ActorLogs")

  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  oauthLoginCodes         OAuthLoginCode[]

  @@index([scheduledDeletionAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Same pattern as PasswordResetToken — opaque token, hashed at rest,
// single-use, short expiry (issued as 24h in jwt.ts).
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Bridges the server-driven Google OAuth redirect back to the SPA. The
// /auth/google/callback handler can't hand back a refresh token directly —
// it would end up in the URL bar, browser history, and server access logs.
// Instead it mints one of these (very short-lived, single-use) and redirects
// with just the opaque code; the frontend immediately exchanges it for a
// real token pair via POST /auth/google/exchange.
model OAuthLoginCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum Role {
  USER
  ORGANIZER
  GUIDE
  ADMIN
}

// Opaque refresh tokens, stored hashed. Supports rotation + revocation so a
// stolen/compromised token (or a "log out everywhere") can be invalidated
// without touching short-lived access tokens.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedBy   String? // tokenHash of the token that rotated this one out
  createdAt    DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// TRIP
// ─────────────────────────────────────────────────────────────────────────
// type = FIXED_DEPARTURE  -> "already planned, join if you want" (has TripDeparture rows)
// type = AVAILABLE        -> flexible / bookable anytime, no fixed group date
// A "custom, build your own trek" request does NOT create a Trip row at all —
// it's just an Inquiry with tripId = null.
model Trip {
  id            String     @id @default(uuid())
  name          String
  // Free text (not an enum) so an Admin/Organizer can add a new region
  // just by typing it when creating a trip — no migration needed. Was
  // `Region` (the enum below) until region management moved to
  // admin-editable free text; the `Region` enum is kept only because
  // Inquiry.regionInterest still uses it.
  region        String
  location      String?
  duration      Int
  difficulty    Difficulty
  price         Int
  description   String
  type          TripType   @default(AVAILABLE)
  bestSeason    String?
  maxAltitudeM  Int?

  highlights    String[]   @default([])
  includes      String[]   @default([])
  excludes      String[]   @default([])

  coverImageUrl      String?
  coverImagePublicId String?

  deletedAt     DateTime? // soft delete — keeps historical bookings/reviews intact
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  photos        TripPhoto[]
  videos        TripVideo[]
  itinerary     ItineraryDay[]
  departures    TripDeparture[]
  inquiries     Inquiry[]
  posts         Post[]
  bookings      Booking[]
  reviews       Review[]
  wishlistedBy  Wishlist[]
  translations  TripTranslation[]

  organizerId String?
  organizer   User?      @relation("OrganizerTrips", fields: [organizerId], references: [id], onDelete: SetNull)
}

enum TripType {
  FIXED_DEPARTURE
  AVAILABLE
}

// Day-by-day plan shown on a trip's detail page.
model ItineraryDay {
  id           String   @id @default(uuid())
  tripId       String
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayNumber    Int
  title        String
  description  String
  meals        String? // e.g. "Breakfast, Lunch, Dinner"
  accommodation String? // e.g. "Teahouse", "Hotel"
  altitudeM    Int?
  distanceKm   Float?

  translations ItineraryDayTranslation[]

  @@unique([tripId, dayNumber])
}

// ─────────────────────────────────────────────────────────────────────────
// TRANSLATIONS (hybrid MT + organizer review)
// ─────────────────────────────────────────────────────────────────────────
// English lives on Trip/ItineraryDay themselves (unchanged) and is always
// the fallback/source language. Every other locale is a row here.
// `source` distinguishes "machine-translated, unreviewed" from "an
// organizer/admin has reviewed/edited this" — REVIEWED rows are never
// silently overwritten by a later auto-retranslate (see
// generateTripTranslations in trip.model.ts). Locale is a plain string
// (not an enum) so adding a supported language is a config change
// (config/locales.ts), not a migration.
model TripTranslation {
  id          String            @id @default(uuid())
  tripId      String
  trip        Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  locale      String

  name        String
  description String
  bestSeason  String?
  highlights  String[]          @default([])
  includes    String[]          @default([])
  excludes    String[]          @default([])

  source      TranslationSource @default(MACHINE)
  reviewedAt  DateTime?
  reviewedBy  String?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([tripId, locale])
  @@index([tripId])
}

model ItineraryDayTranslation {
  id             String            @id @default(uuid())
  itineraryDayId String
  itineraryDay   ItineraryDay      @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  locale         String

  title          String
  description    String
  meals          String?
  accommodation  String?

  source         TranslationSource @default(MACHINE)
  reviewedAt     DateTime?
  reviewedBy     String?

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([itineraryDayId, locale])
  @@index([itineraryDayId])
}

enum TranslationSource {
  MACHINE  // auto-translated, not yet reviewed by a human
  REVIEWED // an organizer/admin has edited or explicitly approved this draft
}

// A planned trip can run more than once. maxSeats + bookings' traveler counts
// let us compute remaining capacity; guideId lets a specific field guide be
// assigned to a specific departure.
model TripDeparture {
  id        String    @id @default(uuid())
  tripId    String
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime?
  note      String?
  maxSeats  Int?

  guideId   String?
  guide     User?     @relation("AssignedGuide", fields: [guideId], references: [id], onDelete: SetNull)

  bookings  Booking[]
  createdAt DateTime  @default(now())
}

model TripPhoto {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  url       String
  publicId  String?
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model TripVideo {
  id           String   @id @default(uuid())
  tripId       String
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  url          String
  publicId     String?
  thumbnailUrl String?
  caption      String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// BOOKING — replaces "just an inquiry" as the real commercial record.
// Supports both logged-in users and guest checkouts (guestName/Email/Phone).
// Payment gateway integration (eSewa/Khalti/Stripe) can populate
// paymentMethod/paymentStatus/amountPaid via a webhook later; for now these
// are settable by an Organizer/Admin (e.g. after a bank transfer or cash
// payment is confirmed).
// ─────────────────────────────────────────────────────────────────────────
model Booking {
  id            String        @id @default(uuid())
  tripId        String
  trip          Trip          @relation(fields: [tripId], references: [id])
  departureId   String?
  departure     TripDeparture? @relation(fields: [departureId], references: [id])

  userId        String?
  user          User?         @relation("UserBookings", fields: [userId], references: [id])
  guestName     String?
  guestEmail    String?
  guestPhone    String?

  travelers     Int           @default(1)
  totalPrice    Int
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod?
  amountPaid    Int           @default(0)
  notes         String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  changeRequests BookingChangeRequest[]
}

// A customer's request to add travelers to an EXISTING booking. Deliberately
// NOT auto-applied — unlike creating a fresh booking, changing the size (and
// therefore the price and seat count) of one that's already been made needs
// an Organizer/Admin to look at seat availability and sign off, the same way
// a status change does. One row per request; a booking can have many over
// its lifetime (one per review cycle), but only ever one PENDING at a time
// (enforced in the model layer, not the DB, since "at most one PENDING per
// bookingId" isn't expressible as a plain unique constraint).
model BookingChangeRequest {
  id                  String              @id @default(uuid())
  bookingId           String
  booking             Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Snapshot of the ask: total travelers the customer wants after this
  // request is approved (not just the delta), so approving it is a single
  // unambiguous number even if the booking's own traveler count could in
  // theory change between request and review.
  requestedTravelers  Int
  additionalTravelers Int
  note                String?

  status              ChangeRequestStatus @default(PENDING)

  requestedByUserId   String?
  reviewedByUserId    String?
  reviewedAt          DateTime?
  reviewNote          String?

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([bookingId])
  @@index([status])
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

// Tracks which client-generated checkout attempts have already been
// processed, and what they resolved to. Deliberately separate from Booking
// itself (rather than a column on it) because one attempt can now resolve
// to EITHER a freshly created Booking OR an existing one that got more
// travelers merged into it (see createBooking in booking.controller.ts) —
// a column directly on Booking can't represent "this attempt's result was
// a booking that already existed before this request came in."
// A double-click, a retried request after a slow/failed response, or a
// back-button resubmit all carry the same idempotencyKey, so the unique
// constraint here is what actually prevents a second row (or a second
// traveler-merge) from happening, not just client-side button-disabling.
model BookingAttempt {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  bookingId      String
  createdAt      DateTime @default(now())
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  ESEWA
  KHALTI
  STRIPE
  FONEPAY
  OTHER
}

// ─────────────────────────────────────────────────────────────────────────
// POST  (social-media style feed)
// ─────────────────────────────────────────────────────────────────────────
model Post {
  id        String   @id @default(uuid())
  authorId  String
  author    User     @relation("AuthoredPosts", fields: [authorId], references: [id], onDelete: Cascade)
  caption   String
  tripId    String?
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos PostPhoto[]
  videos PostVideo[]
}

model PostPhoto {
  id       String  @id @default(uuid())
  postId   String
  post     Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  url      String
  publicId String?
  order    Int     @default(0)
}

model PostVideo {
  id           String  @id @default(uuid())
  postId       String
  post         Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  url          String
  publicId     String?
  thumbnailUrl String?
  order        Int     @default(0)
}

model Inquiry {
  id             String   @id @default(uuid())
  name           String
  email          String
  regionInterest Region?
  message        String
  tripId         String?
  createdAt      DateTime @default(now())
  trip           Trip?    @relation(fields: [tripId], references: [id])
}

// Admin-curated marketing quotes for the homepage. Kept separate from the
// real customer Review system below — this is copywriting, not verified
// customer feedback.
model Testimonial {
  id        String   @id @default(uuid())
  name      String
  country   String
  tripName  String
  quote     String
  createdAt DateTime @default(now())
}

// Real customer reviews, tied to an account and (optionally) a completed
// booking. isVerified is set automatically when the reviewer has a
// COMPLETED booking for that trip.
model Review {
  id         String   @id @default(uuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int // 1-5
  comment    String
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tripId, userId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, tripId])
}

// Lightweight audit trail for admin-visible actions (role changes, deletes,
// booking status changes). Not exhaustive — meant for accountability across
// a multi-organizer team, not full change-data-capture.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// Only used by Inquiry.regionInterest now — Trip.region moved to free-text
// String above so admins/organizers can add new regions without a migration.
enum Region {
  HIMALAYA
  HILLS
  TERAI
}

enum Difficulty {
  EASY
  EASY_MODERATE
  MODERATE
  CHALLENGING
  STRENUOUS
}

// ─────────────────────────────────────────────────────────────────────────
// SITE CONTENT — admin-editable Homepage hero image + About page
// (hero image + copy). Singleton: there is only ever exactly one row, so
// its id is a fixed literal instead of @default(uuid()) — nothing ever
// looks it up by a generated id.
// ─────────────────────────────────────────────────────────────────────────
model SiteContent {
  id                String   @id @default("singleton")

  // Site-wide brand name — shown in Header/Footer in place of the hardcoded
  // "Himalayan Paths". Null falls back to that same hardcoded default.
  siteName          String?

  // Homepage hero
  homeHeroImageUrl  String?
  homeHeroPublicId  String?  // Cloudinary public_id, so we can delete the old image on replace
  homeHeroEyebrow   String?  // small line above the headline, e.g. "Nepal's trusted..."
  homeHeroTitle     String?  // main headline, e.g. "Where the mountains call"
  homeHeroSubtitle  String?  // supporting paragraph under the headline

  // Homepage stats strip — [{ value: string; label: string }]. Admin can
  // add/remove cards, not just edit the default 4.
  homeStats         Json?

  // About page hero
  aboutHeroImageUrl String?
  aboutHeroPublicId String?

  // Auth pages — separate images for Login vs Signup (see AdminPage's
  // "Site" panel). Optional: each page falls back to its own hardcoded
  // default image until an admin uploads one here.
  authLoginImageUrl  String?
  authLoginPublicId  String?  // Cloudinary public_id, so we can delete the old image on replace
  authSignupImageUrl String?
  authSignupPublicId String?

  // About page copy — all optional so the page falls back to its current
  // hardcoded defaults until an admin first edits them.
  aboutIntro        String?  // the bold intro line
  aboutBody         String?  // the paragraph(s) below it
  aboutFeatures     Json?    // [{ title: string; description: string }]
  aboutClosing      String?  // the closing "office in Thamel..." paragraph

  // Footer contact block — falls back to the hardcoded Himalayan Paths
  // defaults (phone/email/tagline) until an admin edits them.
  footerTagline     String?
  footerPhone       String?
  footerEmail       String?
  footerAddress     String?

  // Contact page "Find us" block — deliberately separate from the footer
  // fields above in case the office contact differs from the footer's.
  contactAddress      String?
  contactPhone        String?
  contactEmail        String?
  contactResponseNote String? // the "we reply within 24 hours..." blurb

  // Social links — shared by Footer and the Contact page (single source of
  // truth, edited from one place). [{ platform: string; url: string }].
  // Admin can add or remove entries freely; not fixed Instagram/Facebook
  // columns.
  socialLinks       Json?

  updatedAt         DateTime @updatedAt
}
