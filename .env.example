# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:3000

# ── Database (Supabase Postgres or any Postgres instance) ───────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# ── Supabase (optional — only needed if you use Supabase Storage too) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudinary (all media: avatars, trip covers/galleries, posts) ──────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (booking confirmations, inquiry notifications) ───────────────
# Any SMTP provider works (Gmail app password, SendGrid, Mailgun, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Bhraman Treks <no-reply@bhraman.com>"
ADMIN_NOTIFICATION_EMAIL=

# ── Seeding ─────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ORGANIZER_EMAIL=
SEED_ORGANIZER_PASSWORD=
SEED_ORGANIZER_NAME=
SEED_GUIDE_EMAIL=
SEED_GUIDE_PASSWORD=
SEED_GUIDE_NAME=
